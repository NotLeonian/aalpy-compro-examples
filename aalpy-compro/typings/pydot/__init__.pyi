"""Partial stubs for the graph API used by AALpy's file helpers."""

from os import PathLike
from typing import Any

class Common:
    obj_dict: dict[str, Any]

    def __init__(self, obj_dict: dict[str, Any] | None = None) -> None: ...
    def set(self, name: str, value: Any) -> None: ...
    def get(self, name: str) -> Any: ...
    def get_attributes(self) -> dict[str, Any]: ...

class Node(Common):
    def __init__(
        self,
        name: str = "",
        obj_dict: dict[str, Any] | None = None,
        **attrs: Any,
    ) -> None: ...
    def get_name(self) -> str: ...
    def set_name(self, node_name: str | None) -> None: ...
    def get_label(self) -> str | None: ...
    def set_label(self, label: str) -> None: ...
    def to_string(self, indent: Any = "", indent_level: int = 1) -> str: ...

class Edge(Common):
    def __init__(
        self,
        src: str | Node = "",
        dst: str | Node = "",
        obj_dict: dict[str, Any] | None = None,
        **attrs: Any,
    ) -> None: ...
    def get_source(self) -> str: ...
    def get_destination(self) -> str: ...
    def get_label(self) -> str | None: ...
    def set_label(self, label: str) -> None: ...
    def to_string(self, indent: Any = "", indent_level: int = 1) -> str: ...

class Graph(Common):
    def __init__(
        self,
        graph_name: str = "G",
        obj_dict: dict[str, Any] | None = None,
        graph_type: str = "digraph",
        strict: bool = False,
        suppress_disconnected: bool = False,
        simplify: bool = False,
        **attrs: Any,
    ) -> None: ...
    def add_node(self, graph_node: Node) -> None: ...
    def add_edge(self, graph_edge: Edge) -> None: ...
    def get_node(self, name: str) -> list[Node]: ...
    def get_nodes(self) -> list[Node]: ...
    def get_node_list(self) -> list[Node]: ...
    def get_edges(self) -> list[Edge]: ...
    def get_edge_list(self) -> list[Edge]: ...
    def to_string(
        self,
        indent: Any = "",
        indent_level: int = 0,
        inline: bool = False,
    ) -> str: ...

class Dot(Graph):
    def write(
        self,
        path: str | bytes | PathLike[str] | PathLike[bytes],
        prog: str | None = None,
        format: str = "raw",
        encoding: str | None = None,
    ) -> bool: ...
    def create(
        self,
        prog: list[str] | tuple[str] | str | None = None,
        format: str = "ps",
        encoding: str | None = None,
    ) -> bytes: ...

def graph_from_dot_data(s: str) -> list[Dot] | None: ...
def graph_from_dot_file(
    path: str | bytes | PathLike[str] | PathLike[bytes],
    encoding: str | None = None,
) -> list[Dot] | None: ...
